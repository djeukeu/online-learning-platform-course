{
	"name": "online-learning-platform-course",
	"version": "1.0.0",
	"main": "index.js",
	"license": "MIT",
	"scripts": {
		"start": "node dist/server.js",
		"start:dev": "env-cmd -f .env.development nodemon",
		"build": "tsc && resolve-tspaths",
		"pretty": "prettier --write ./src/**/* ",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"docker-compose": "env-cmd -f .env.development docker-compose up -d",
		"prisma:dev": "env-cmd -f .env.development prisma migrate dev --name development",
		"prisma:deploy": "prisma migrate deploy"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.37.0",
		"env-cmd": "^10.1.0",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.1",
		"globals": "^16.3.0",
		"nodemon": "^3.1.10",
		"prettier": "^3.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.37.0"
	}
}
