generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id           String       @id @default(uuid())
  title        String
  description  String
  price        Decimal
  intructor_id String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([intructor_id])
  @@map("course")
}